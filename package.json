{
  "name": "metricas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n front,back -c cyan,magenta \"npm run dev:front\" \"npm run dev:back\"",
    "dev:front": "vite",
    "dev:back": "npm run start:dev --prefix backend",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
